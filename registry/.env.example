# Agora registry config

# DB path. In dev: defaults to <repo>/registry.db.
# In containerized deployments: set to an absolute path on a persistent
# volume, e.g. /data/registry.db.
# AGORA_REGISTRY_DB_PATH=/data/registry.db

# Migrations directory. Override in containerized deployments where the
# bundled migrations folder is at a known absolute path.
# AGORA_MIGRATIONS_DIR=/app/migrations

# Admin secret for /v1/admin/* and /v1/platform/* endpoints.
# REQUIRED if you want to use admin endpoints. Must be ≥ 16 chars.
# When unset, admin routes return 503 (fail-secure).
# Generate with:  openssl rand -hex 32
# ADMIN_SECRET=

# Mock mode (registry has no wallet of its own; this only affects test-mode features)
MOCK_MODE=true
